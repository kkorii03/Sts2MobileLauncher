<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer. Restores only run when the app is (re)installed,
  so they never overwrite saves on an existing install.
  Cloud backup (25 MB quota): the shared game saves only.
  Device transfer (e.g. Smart Switch to a new phone): saves plus local save
  snapshots, without the multi-GB game payload/runtime (re-extracted from the APK).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="default" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="default" />
        <include domain="file" path="save-snapshots" />
    </device-transfer>
</data-extraction-rules>
